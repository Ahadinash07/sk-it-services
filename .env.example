# The CMS opens at /admin behind an admin login screen.
# Set these two values on every deployment (local, staging and production).
# The password and session secret must never be committed to source control.
CMS_ADMIN_PASSWORD=change-me-admin-password
CMS_SESSION_SECRET=change-me-session-secret

# Optional persistent path. Defaults to storage/content.json relative to the project directory.
# CMS_DATA_FILE=storage/content.json
